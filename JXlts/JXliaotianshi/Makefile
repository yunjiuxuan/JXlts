####### Compile

liaotianwin.o: liaotianwin.cpp liaotianwin.h \
		ui_liaotianwin.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o liaotianwin.o liaotianwin.cpp

main.o: main.cpp mainwindow.h \
		userhome.h \
		liaotianwin.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

mainwindow.o: mainwindow.cpp mainwindow.h \
		userhome.h \
		liaotianwin.h \
		ui_mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o mainwindow.cpp

userhome.o: userhome.cpp userhome.h \
		liaotianwin.h \
		ui_userhome.h \
		mainwindow.h \
		ui_mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o userhome.o userhome.cpp

moc_liaotianwin.o: moc_liaotianwin.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_liaotianwin.o moc_liaotianwin.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_userhome.o: moc_userhome.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_userhome.o moc_userhome.cpp

####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/JXliaotianshi/bin || mkdir -p $(INSTALL_ROOT)/opt/JXliaotianshi/bin
	-$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/opt/JXliaotianshi/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/opt/JXliaotianshi/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/JXliaotianshi/bin/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

